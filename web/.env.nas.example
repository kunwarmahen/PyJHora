# ─────────────────────────────────────────────────────────────────────────────
# NAS deployment config.  Copy to `.env` in this (web/) directory and fill in:
#     cp .env.nas.example .env
# Then:  ./dev.sh nas deploy
#
# This file is consumed two ways:
#   • docker-compose.nas.yml substitutes ${VARS} and the backend reads it via env_file
#   • dev.sh reads the NAS_* / REACT_APP_* values to build + ship the images
# ─────────────────────────────────────────────────────────────────────────────

# ── NAS connection (SSH → remote Docker) ─────────────────────────────────────
# IP or hostname of the NAS (required)
NAS_HOST=
# SSH user (default: your local username)
NAS_USER=
# remote deploy dir; relative = NAS home (~/pyjhora)
NAS_PATH=pyjhora
# NAS_SSH_KEY=~/.ssh/id_rsa     # optional; default uses your SSH agent / default key
# NAS_SSH_PORT=22

# ── Cloudflare Tunnel ────────────────────────────────────────────────────────
# Create a *remote-managed* tunnel in the Cloudflare dashboard (Zero Trust →
# Networks → Tunnels), add a Public Hostname (e.g. astro.yourdomain.com) routed to
# the service  http://web:80 , then paste the tunnel token here. Cloudflare handles
# the domain + SSL; nothing is exposed on your router.
TUNNEL_TOKEN=

# ── App: database ────────────────────────────────────────────────────────────
MONGO_USER=admin
# REQUIRED — pick a strong password (avoid '@' — it breaks the mongodb:// URL)
MONGO_PASSWORD=
DATABASE_NAME=jyotirai_db
# Absolute host path for MongoDB's data files (bind-mounted to /data/db). Keep it
# OUTSIDE the deploy dir so redeploys never touch it; back this folder up to
# preserve the database. Unset = ./mongo-data next to the compose file.
MONGO_DATA_PATH=/volume1/Docker/jyotirai/mongo-data

# ── App: security + origins ──────────────────────────────────────────────────
# REQUIRED — long random string (JWT signing)
SECRET_KEY=
# Public origin(s) allowed by CORS. Same-origin behind the tunnel means CORS isn't
# strictly needed, but list your domain to be safe. JSON array, no trailing slash.
CORS_ORIGINS=["https://astro.yourdomain.com"]
# Absolute base URL used in outbound email links (password reset, etc.). No trailing slash.
APP_BASE_URL=https://astro.yourdomain.com

# ── Branding (baked into the frontend build) ─────────────────────────────────
REACT_APP_SITE_TITLE=Jyotir AI
REACT_APP_SITE_TAGLINE=Where Vedic Wisdom Meets AI
REACT_APP_ENABLE_MAP_PICKER=true
# Keep MAP_PICKER_ENABLED in sync with the frontend flag above.
MAP_PICKER_ENABLED=true

# ── LLM providers (set whichever you use; all optional) ──────────────────────
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=
# OLLAMA_URL=
# OLLAMA_DEFAULT_MODEL=qwen2.5:14b

# ── Transactional email (optional; unset = log-only no-op) ───────────────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Jyotir AI <no-reply@yourdomain.com>
# SMTP_USE_TLS=true

# ── Web Push / VAPID (optional; unset = push disabled) ───────────────────────
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@yourdomain.com
