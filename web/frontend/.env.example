# Base URL of the PyJHora backend API. REQUIRED for production builds — the app
# throws at startup if it's unset in production (see src/services/api.js). In dev
# it falls back to http://localhost:8000 with a console warning.
REACT_APP_API_URL=http://localhost:8000

# Axios request timeout in ms (optional; defaults to 30000).
REACT_APP_API_TIMEOUT=30000
