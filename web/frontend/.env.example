# Brand name shown across the app (nav bar, dashboard, login/register/shared
# pages) and used as the browser tab title. Optional; defaults to "Jyotir AI".
REACT_APP_SITE_TITLE=Jyotir AI


# Tagline under the brand name on the login screen. Optional; when unset it
# falls back to the translated default ("Vedic Astrology Web Application").
# e.g. REACT_APP_SITE_TAGLINE=The AI-native Vedic Astrology Platform
REACT_APP_SITE_TAGLINE=Where Vedic Wisdom Meets AI

# Base URL of the PyJHora backend API. Optional — when unset, the app defaults to
# the SAME host the page was served from, on port 8000 (see src/services/api.js),
# so it works over the LAN from any device with no per-device config. Set it to pin
# the backend to a specific URL (e.g. a separate API host in production).
REACT_APP_API_URL=http://localhost:8000

# Axios request timeout in ms (optional; defaults to 30000).
REACT_APP_API_TIMEOUT=30000

# Interactive map location picker (Leaflet + free OpenStreetMap tiles / Nominatim
# reverse-geocoding). Defaults to true. Set to false to hide the map and fall
# back to the text search box — pair with the backend's MAP_PICKER_ENABLED=false
# to also disable the /api/location/reverse endpoint for production.
REACT_APP_ENABLE_MAP_PICKER=true

# Public marketing landing page (shown at "/" to signed-out visitors). Set to
# "true" to show the pricing section (Free / Pro / Practitioner tiers); any other
# value hides the whole pricing block while keeping the sign-up CTAs. Tier numbers
# are placeholders in src/pages/LandingPage.js until finalized. Defaults to hidden.
REACT_APP_SHOW_PRICING=false
