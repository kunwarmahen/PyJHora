# Jyotir AI MCP server config. Copy to `.env` (or set these in your MCP client).
# Base URL of the running Jyotir AI web backend.
JYOTIR_API_URL=http://localhost:8000
# A personal API token — create one under Settings → API access in the web app.
JYOTIR_API_TOKEN=jyd_replace_me
# Transport: "stdio" (Claude Desktop / local clients) or "http" (streamable-HTTP).
MCP_TRANSPORT=stdio
# Only used when MCP_TRANSPORT=http:
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8765
