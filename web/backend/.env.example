MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=jyotirai_db
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh-token lifetimes (days). The frontend silently refreshes the short
# access token using a revocable refresh token, so users stay signed in.
# "Remember me" on login picks the long TTL; a plain login gets the short one.
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_TOKEN_SHORT_DAYS=1

# LLM Configuration

# Ollama - Local, Free, Private (installed models are auto-discovered)
# Install: curl https://ollama.ai/install.sh | sh
# Run: ollama serve
# Pull a model: ollama pull qwen2.5
OLLAMA_URL=http://localhost:11434
# Server-side default model. Shown in Settings → AI / System and used when the
# user leaves the model field blank, so a fresh deploy picks it up automatically.
OLLAMA_DEFAULT_MODEL=qwen2.5:14b

# Generic OpenAI-compatible local server (LM Studio, llama.cpp, vLLM, text-gen-webui)
# Point this at any server exposing the OpenAI /v1 schema; models are auto-listed.
OPENAI_COMPATIBLE_URL=http://localhost:1234/v1
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_API_KEY=

# Google Gemini - Requires API key
# Get key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_DEFAULT_MODEL=gemini-1.5-flash

# OpenAI ChatGPT - Requires API key
# Get key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# OpenRouter - one key, hundreds of hosted models (Claude, GPT, Gemini, Llama,
# DeepSeek, ...). Requires API key; get one from: https://openrouter.ai/keys
# The model list is fetched live from OpenRouter, so no model list to maintain.
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=google/gemini-2.5-flash
# Rarely needed: endpoint override.
# OPENROUTER_URL=https://openrouter.ai/api/v1
# Optional: public URL of this deployment, sent to OpenRouter as the attribution
# header so the traffic is labelled in your OpenRouter dashboard.
# SITE_URL=https://example.com

# Every cloud provider's model dropdown is fetched live from the vendor (so new
# releases appear without a code change) and cached for this many seconds.
# LLM_MODEL_CACHE_TTL=900

# Per-user API-key encryption. Keys users save in the UI are stored encrypted
# (Fernet) using this secret; falls back to SECRET_KEY if unset. Set a dedicated,
# stable value in production — changing it makes already-stored keys unreadable.
API_KEY_ENCRYPTION_KEY=change-this-to-a-long-random-string

# Per-user rate limits on the AI endpoints (ask / ask-stream).
AI_RATE_LIMIT_PER_MIN=20
AI_RATE_LIMIT_PER_DAY=300

# Unified AI history retention. Every AI reading + chat (across all tools) is
# saved automatically and shown on the History page. This caps how many items are
# kept per user — the newest N; older ones are pruned on write. Readings pile up
# (each generation is its own item); users can delete any item individually.
AI_HISTORY_MAX=100

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Interactive map location picker (Leaflet + free OpenStreetMap tiles / Nominatim).
# Set to false to fully disable it for production: the /api/location/reverse
# endpoint returns 403 and the frontend hides the map (also set the frontend's
# REACT_APP_ENABLE_MAP_PICKER=false to match). Defaults to true.
MAP_PICKER_ENABLED=true

# Public URL of the frontend — used to build links in outbound email (password
# reset). No trailing slash.
APP_BASE_URL=http://localhost:3000

# Product / brand name used in outbound email (digest subject/body) and the API
# docs title. Keep in sync with the frontend's REACT_APP_SITE_TITLE. Defaults to
# "Jyotir AI". (This is the app brand, not the underlying jhora calculation library.)
SITE_NAME=Jyotir AI

# --- Transactional email (SMTP) ---
# Provider-agnostic. Works with Gmail (use an App Password), SendGrid, Mailgun,
# Amazon SES SMTP, etc. Leave SMTP_HOST blank to disable real sending — the app
# then logs the reset link to the console instead (fine for local dev). Port 587
# = STARTTLS (SMTP_USE_TLS=true); port 465 = implicit SSL.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Jyotir AI <no-reply@example.com>
SMTP_USE_TLS=true
PASSWORD_RESET_TTL_MINUTES=30

# --- Web Push (PWA notifications) via VAPID ---
# Generate a keypair once:  python -m notifications genkeys
# Leave blank to disable browser push (subscribe endpoints return 503; email +
# in-app digest still work). The public key is also exposed to the frontend.
# Even with keys set, browsers only permit push on a secure context (HTTPS or
# http://localhost); over a plain-HTTP LAN hostname the toggle reads "unavailable".
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Daily-digest scheduler ---
# When true, an in-process background task delivers each opted-in user's digest
# once a day at (or after) their preferred local hour (email + push) — a target
# hour missed while the process was down still delivers later that day. Off by default — you
# can instead point your own cron at POST /api/notifications/digest/send. Safe to
# run with multiple uvicorn workers (a DB claim prevents double-sends). The wake
# interval must be under 60 minutes so every target hour is caught.
DIGEST_SCHEDULER_ENABLED=false
DIGEST_SCHEDULER_INTERVAL_MINUTES=15

# --- Admin console (§44) ---
# Comma-separated usernames and/or emails that get the deployer-only admin
# console (a page at /admin: every account, usage aggregates, moderation).
# This env var is the SOURCE OF TRUTH — the app reconciles the users' is_admin
# flag from it on startup, so you grant/revoke admin by editing THIS value and
# redeploying, never by touching Mongo (which is only reachable inside the pod).
# Each entry matches a user by username OR email, case-insensitive.
# Empty (default) ⇒ no admins and the console is effectively off.
ADMIN_USERNAMES=
# "Break glass" switch. false (default) ⇒ the console shows metadata + counts
# only. Set true and redeploy ONLY when you must inspect a user's actual private
# content (readings, chats, journal, birth data) to resolve a real problem;
# every such view is audit-logged. Turn it back off afterwards.
ADMIN_CONTENT_ACCESS=false
